    "asset_editor.preview.hint_rigged": (en: "Drag a handle to pose, elsewhere to orbit; right or middle mouse moves the view, scroll zooms", de: "Griff ziehen zum Posieren, sonst Orbit; rechte oder mittlere Maustaste verschiebt die Ansicht, Scrollen zoomt"),
